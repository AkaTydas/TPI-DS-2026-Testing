      "name": "7. Inspeccionar las 3 Bases de Datos Aisladas (Database per Service)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Las 3 bases de datos SQLite están desacopladas y contienen registros\", function () {",
              "    var json = pm.response.json();",
