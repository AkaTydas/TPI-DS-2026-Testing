  "item": [
    {
      "name": "1. Healthcheck",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Servidor M9 está UP\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.estado).to.eql(\"UP\");",
              "    pm.expect(json.grupo).to.eql(8);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Crear Reserva (Para Flujo Exitoso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Reserva creada con estado CONFIRMADA\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.reserva).to.be.an(\"object\");",
              "    pm.expect(json.reserva.id).to.be.a(\"string\");",
              "    pm.expect(json.reserva.estado).to.eql(\"CONFIRMADA\");",
              "    pm.collectionVariables.set(\"reservaId\", json.reserva.id);",
              "    pm.collectionVariables.set(\"reservaOkId\", json.reserva.id);",
              "    pm.environment.set(\"reservaId\", json.reserva.id);",
              "    pm.environment.set(\"reservaOkId\", json.reserva.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "req-pm-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"cli-alumno-utn\",\n  \"origen\": \"Av. Castelli 930\",\n  \"destino\": \"Campus UTN FRRe\",\n  \"tarifaEstimada\": 3500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservas"
          ]
        }
      }
    },
    {
      "name": "3. Activar Saga - Escenario Exitoso (Todo OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Saga finalizó con éxito y reserva ACTIVADA\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.exito).to.eql(true);",
              "    pm.expect(json.estadoFinal).to.eql(\"ACTIVADA\");",
              "    pm.expect(json.conductorAsignadoM5).to.not.be.null;",
              "    pm.expect(json.saldoRetenidoM7).to.eql(3500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "idem-pm-ok-{{reservaOkId}}"
          },
          {
            "key": "X-Request-Id",
            "value": "req-saga-ok-{{reservaOkId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"forzarFalloM5\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas/{{reservaOkId}}/activar-saga",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservas",
            "{{reservaOkId}}",
            "activar-saga"
          ]
        }
      }
    },
    {
      "name": "4. Crear Reserva (Para Flujo con Fallo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Segunda reserva creada para prueba de compensación\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.reserva).to.be.an(\"object\");",
              "    pm.expect(json.reserva.id).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"reservaFalloId\", json.reserva.id);",
              "    pm.environment.set(\"reservaFalloId\", json.reserva.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "req-pm-002"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"cli-alumno-utn-fallo\",\n  \"origen\": \"Ruta 11 Km 1005\",\n  \"destino\": \"Zona Rural Periférica\",\n  \"tarifaEstimada\": 5200\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservas"
          ]
        }
      }
    },
    {
      "name": "5. Activar Saga - Escenario Fallo y Compensación (C2 -> C1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Saga detectó fallo en M5 y compensó a VENCIDA\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.exito).to.eql(false);",
              "    pm.expect(json.estadoFinal).to.eql(\"VENCIDA\");",
              "    pm.expect(json.saldoRetenidoM7).to.eql(0);",
              "    pm.expect(json.pasosEjecutados).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "idem-pm-err-{{reservaFalloId}}"
          },
          {
            "key": "X-Request-Id",
            "value": "req-saga-err-{{reservaFalloId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"forzarFalloM5\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas/{{reservaFalloId}}/activar-saga",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservas",
            "{{reservaFalloId}}",
            "activar-saga"
          ]
        }
      }
    },
    {
      "name": "6. Consultar Historial de Auditoría Inmutable (RF-9.12)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Historial de auditoría contiene eventos inmutables registrados\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.historial).to.be.an(\"array\");",
              "    pm.expect(json.historial.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
